ATPROTO_HOST=https://bsky.social
ATPROTO_IDENTIFIER=
ATPROTO_PASSWORD=

LINKDING_ENDPOINT=
LINKDING_API_KEY=

# Set to true to ignore archived bookmarks in Linkding.
IGNORE_ARCHIVED=true

# Set to true to not actually send any data to the AT Protocol API, but to see
# the contents of the records that would be created.
DRY_RUN=true

# Path to a CSV file that tracks already-imported bookmarks for error recovery.
# If the import fails partway through, run the tool again to resume from where it left off.
# PROCESSED_IDS_FILE=processed-bookmarks.csv
